---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getContent, getLang } from '../i18n';

const { site, articles, ui } = getContent(getLang(Astro.url));
const visible = site.journalEnabled ? articles : [];
---

<Base title={ui.journal} description={ui.journalLead}>
  <div class="wrap">
    <header class="page-head">
      <h1 class="page-title">{ui.journal}</h1>
      <p class="lead">{ui.journalLead}</p>
    </header>
    {visible.length > 0 ? (
      <ul class="post-feed">
        {visible.map((article, index) => (
          <li>
            <ArticleCard article={article} headingLevel="h2" variant={index === 0 ? 'feature' : 'row'} />
          </li>
        ))}
      </ul>
    ) : (
      <p class="prose">{ui.journalEmpty}</p>
    )}
  </div>
</Base>
