---
import { existsSync } from 'node:fs';
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import HeroLine from '../components/HeroLine.astro';
import { getContent, getLang, l } from '../i18n';

const lang = getLang(Astro.url);
const { site, projects, articles, ui } = getContent(lang);
// Add public/images/home-photo.jpg and it replaces the placeholder automatically.
const photo = existsSync('public/images/home-photo.jpg') ? '/images/home-photo.jpg' : undefined;
const taglineParts = site.tagline.split(` ${site.taglineAccent} `);
const featured = projects.filter((p) => p.featured).slice(0, 6);
const notes = site.journalEnabled ? articles.slice(0, 3) : [];
---

<Base>
  <section class="hero wrap">
    <div class="hero-top">
      <div>
        <p class="eyebrow">{site.home.eyebrow}</p>
        <h1>
          {taglineParts.length === 2 ? (
            <>{taglineParts[0]} <em>{site.taglineAccent}</em> {taglineParts[1]}</>
          ) : (
            site.tagline
          )}
        </h1>
        <p class="descriptor">{site.descriptor}</p>
      </div>
      <div class="hero-photo">
        <Media label="Portrait" ratio="4/3" src={photo} alt={`${ui.portraitOf} ${site.name}`} eager />
      </div>
    </div>
    <HeroLine />
    <div class="hero-body">
      <p>{site.home.body}</p>
      <a class="button" href={l(lang, '/work')}>{site.home.cta}</a>
    </div>
  </section>

  <nav class="wrap" aria-label={ui.byDiscipline}>
    <ul class="paths">
      {site.disciplines.map((d) => (
        <li>
          <a class="path" href={l(lang, d.href)}>
            <span class="path-code" aria-hidden="true">{d.code}</span>
            <span class="path-name">{d.name}</span>
            <span class="path-desc">{d.description}</span>
            <span class="path-arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <section class="section wrap" aria-labelledby="featured-title">
    <div class="section-head">
      <h2 id="featured-title">{ui.featuredTitle}</h2>
      <a class="link" href={l(lang, '/work')}>{ui.viewAll}</a>
    </div>
    <ul class="featured">
      {featured.map((project) => (
        <li><ProjectCard project={project} /></li>
      ))}
    </ul>
  </section>

  <section class="section wrap split" aria-labelledby="about-title">
    <h2 id="about-title">{ui.about}</h2>
    <div class="split-stack">
      <p class="lead">{site.home.shortAbout}</p>
      <a class="link" href={l(lang, '/about')}>{ui.moreAbout}</a>
    </div>
  </section>

  {notes.length > 0 && (
    <section class="section wrap" aria-labelledby="journal-title">
      <div class="section-head">
        <h2 id="journal-title">{ui.journalLead}</h2>
        <a class="link" href={l(lang, '/journal')}>{ui.readJournal}</a>
      </div>
      <ul class="journal-grid">
        {notes.map((article) => (
          <li><ArticleCard article={article} /></li>
        ))}
      </ul>
    </section>
  )}
</Base>
