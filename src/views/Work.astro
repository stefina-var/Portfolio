---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import FilterBar from '../components/FilterBar.astro';
import { getContent, getLang } from '../i18n';

const { projects, site, ui } = getContent(getLang(Astro.url));
const options = [
  { value: 'architecture', label: ui.filters.architecture },
  { value: 'design', label: ui.filters.design },
];
// Opens on the design projects; ?filter=architecture switches it.
const initial = 'design';
---

<Base title={ui.work} description={ui.featuredTitle}>
  <div class="wrap">
    <div class="work-top">
      <header class="page-head">
        <h1 class="page-title">{ui.work}</h1>
        <p class="lead">{ui.workIntro}</p>
        <p class="page-sub">{ui.featuredTitle}</p>
      </header>
      <div class="work-filters">
        <FilterBar target="work-list" options={options} label={ui.filterWork} initial={initial} />
        {options.map((option) => (
          <ul class="tags skill-pills" data-skills-for={option.value} aria-label={`${ui.tools}: ${option.label}`} hidden={option.value !== initial}>
            {site.workSkills[option.value as keyof typeof site.workSkills].map((skill) => <li>{skill}</li>)}
          </ul>
        ))}
      </div>
    </div>
    <ul class="index-grid" id="work-list">
      {projects.map((project) => (
        <li data-category={project.category === 'architecture' ? 'architecture' : 'design'} hidden={(project.category === 'architecture' ? 'architecture' : 'design') !== initial}>
          <ProjectCard project={project} ratio="4/3" headingLevel="h2" />
        </li>
      ))}
    </ul>
  </div>
</Base>
