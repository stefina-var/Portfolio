---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Media from '../components/Media.astro';
import Deck from '../components/Deck.astro';
import { getContent, getLang, l } from '../i18n';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  previous?: Project;
  next?: Project;
}

const { project } = Astro.props;
const lang = getLang(Astro.url);
const { site, ui } = getContent(lang);

const facts = [
  site.showSheetNumbers ? [ui.sheet, project.sheet] : undefined,
  [ui.discipline, project.disciplines.join(', ')],
  [ui.type, ui.projectTypes[project.type]],
  [ui.year, project.year],
  [ui.role, project.role],
  [ui.collaborators, project.collaborators],
].filter((fact): fact is string[] => Boolean(fact && fact[1]));

const sections = [
  [ui.overview, project.overview],
  [ui.challenge, project.challenge],
  [ui.approach, project.approach],
  [ui.outcome, project.outcome],
  [ui.credits, project.credits],
].filter((section): section is string[] => Boolean(section[1]));

// Blank lines split paragraphs; **text** is bold.
const paragraphs = (text: string) =>
  text.split(/\n\s*\n/).map((p) => p.split('**').map((part, i) => ({ text: part, bold: i % 2 === 1 })));
---

<Base title={project.title} description={project.summary}>
  <article class={`t-${project.category}`}>
    <header class="wrap page-head">
      <Breadcrumb href={l(lang, '/work')} label={ui.work} current={project.disciplines[0]} />
      <h1 class="page-title">{project.title}</h1>
      <p class="lead">{project.summary}</p>
      <dl class="title-block">
        {facts.map(([term, value]) => (
          <div>
            <dt>{term}</dt>
            <dd>{value}</dd>
          </div>
        ))}
      </dl>
    </header>

    <div class="wrap">
      {project.deck?.length ? (
        <Deck slides={project.deck} ratio={project.deckRatio} />
      ) : (
        <Media label={project.hero.kind} ratio={project.hero.ratio} src={project.cover} alt={project.coverAlt} eager />
      )}
    </div>

    <div class="section wrap case-sections">
      {sections.map(([heading, text]) => (
        <section class="case-section">
          <h2>{heading}</h2>
          <div class="prose">
            {paragraphs(text).map((parts) => (
              <p>{parts.map((part) => (part.bold ? <strong>{part.text}</strong> : part.text))}</p>
            ))}
          </div>
        </section>
      ))}
      {project.externalLink && (
        <p><a class="link" href={project.externalLink.href}>{project.externalLink.label}</a></p>
      )}
    </div>

    {project.gallery.length > 0 && (
      <section class="section wrap" aria-label={ui.visuals}>
        <div class="gallery">
          {project.gallery.map((visual) => (
            <figure class={visual.width}>
              <Media label={visual.kind} ratio={visual.ratio} src={visual.src} alt={visual.alt} />
              {visual.caption && <figcaption>{visual.caption}</figcaption>}
            </figure>
          ))}
        </div>
      </section>
    )}
  </article>

</Base>
