---
import Media from './Media.astro';
import { getContent, getLang, l } from '../i18n';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  ratio?: string;
  headingLevel?: 'h2' | 'h3';
}

const { project, ratio, headingLevel: Heading = 'h3' } = Astro.props;
const lang = getLang(Astro.url);
const { site, ui } = getContent(lang);
---

<a class="card" href={l(lang, `/work/${project.slug}`)}>
  <Media label={project.hero.kind} ratio={ratio} src={project.cover} alt={project.coverAlt} />
  <div class="card-info">
    <div class="card-top">
      {site.showSheetNumbers && <span class="card-sheet">{project.sheet}</span>}
      <span>{project.disciplines.join(', ')}</span>
      {project.year && <span>{project.year}</span>}
      {project.sample && <span class="badge">{ui.sample}</span>}
    </div>
    <Heading class="card-title">{project.title}</Heading>
    <p class="card-summary">{project.summary}</p>
  </div>
</a>
