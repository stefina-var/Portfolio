---
import Media from './Media.astro';
import { getContent, getLang, l } from '../i18n';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  ratio?: string;
  headingLevel?: 'h2' | 'h3';
}

const { project, ratio, headingLevel: Heading = 'h3' } = Astro.props;
const lang = getLang(Astro.url);
const { ui } = getContent(lang);
---

<a class="card" href={l(lang, `/work/${project.slug}`)}>
  <Media label={project.hero.kind} ratio={ratio} src={project.cover} alt={project.coverAlt} />
  <div class="card-info">
    <ul class="pills" aria-label={ui.projectInfo}>
      {project.year && <li class="pill pill-year">{project.year}</li>}
      {project.disciplines.map((d) => <li class="pill">{d}</li>)}
      {project.sample && <li class="badge">{ui.sample}</li>}
    </ul>
    <Heading class="card-title">{project.title}</Heading>
    <p class="card-summary">{project.summary}</p>
    {project.tools?.length ? (
      <ul class="pills pills-tools" aria-label={ui.toolsUsed}>
        {project.tools.map((t) => <li class="pill pill-tool">{t}</li>)}
      </ul>
    ) : null}
  </div>
</a>
