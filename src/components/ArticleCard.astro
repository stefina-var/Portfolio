---
import Media from './Media.astro';
import { getLang, l } from '../i18n';
import type { Article } from '../data/journal';

interface Props {
  article: Article;
  headingLevel?: 'h2' | 'h3';
  variant?: 'card' | 'feature' | 'row';
}

const { article, headingLevel: Heading = 'h3', variant = 'card' } = Astro.props;
const lang = getLang(Astro.url);
const ratio = variant === 'feature' ? '3/2' : '4/3';
---

<a class:list={['card', `post-${variant}`, { 'no-cover': !article.cover }]} href={l(lang, `/journal/${article.slug}`)}>
  {article.cover && <Media label="Cover image" ratio={ratio} src={article.cover} alt={article.coverAlt} />}
  <div class="card-info">
    <Heading class="card-title">{article.title}</Heading>
    <p class="card-summary">{article.excerpt}</p>
  </div>
</a>
