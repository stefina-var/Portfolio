---
import Icon from './Icon.astro';
import { getContent, getLang } from '../i18n';

const { site, ui } = getContent(getLang(Astro.url));
const { email, phone, linkedin, instagram, location } = site.contact;
const links = [
  email && { label: email, href: `mailto:${email}`, icon: 'mail' },
  phone && { label: phone, href: `tel:${phone.replaceAll(' ', '')}`, icon: 'phone' },
  linkedin && { label: 'LinkedIn', href: linkedin, icon: 'link' },
  instagram && { label: 'Instagram', href: instagram, icon: 'link' },
].filter(Boolean) as { label: string; href: string; icon: string }[];
---

{links.length > 0 ? (
  <ul class="contact-links">
    {links.map((link) => (
      <li><a class="link" href={link.href}><Icon name={link.icon} />{link.label}</a></li>
    ))}
    {location && <li class="contact-place"><Icon name="pin" />{location}</li>}
  </ul>
) : (
  <p class="meta">{ui.noContact}</p>
)}
