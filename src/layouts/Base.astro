---
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource-variable/source-serif-4/opsz-italic.css';
import '@fontsource-variable/golos-text/wght.css';
import '@fontsource-variable/sofia-sans/wght.css';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { getContent, getLang, l, stripLang } from '../i18n';

interface Props {
  title?: string;
  description?: string;
}

const lang = getLang(Astro.url);
const { site, ui } = getContent(lang);
const { title, description = site.description } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.tagline}`;
const path = stripLang(Astro.url.pathname);
const nav = [
  { href: '/work', label: ui.work },
  { href: '/about', label: ui.about },
  { href: '/journal', label: ui.journal },
];
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
// The footer invitation: the question stays quiet, the call to action ("Let's connect.") stands out.
const inviteSplit = site.contact.invitation.lastIndexOf('? ') + 1;
const inviteAsk = inviteSplit ? site.contact.invitation.slice(0, inviteSplit) : '';
const inviteCta = site.contact.invitation.slice(inviteSplit).trim();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'bg' ? 'bg_BG' : 'en_GB'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      (function () {
        var theme;
        try { theme = localStorage.getItem('theme'); } catch (e) {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
        document.documentElement.classList.add('js');
        var ok;
        try { ok = localStorage.getItem('site-unlocked') === '1'; } catch (e) {}
        if (!ok) document.documentElement.classList.add('locked');
      })();
    </script>
    <style is:inline>
      /* Simple password screen. It keeps casual visitors out; it is not real security. */
      html.locked body > :not(.gate) { display: none !important; }
      .gate { display: none; }
      html.locked .gate { position: fixed; inset: 0; z-index: 9999; display: grid; place-items: center; padding: 1rem; background: var(--bg, #f4f4f6); }
      .gate form { width: min(100%, 22rem); display: grid; gap: 0.75rem; padding: 2rem; border-radius: 1.5rem; background: var(--paper, #fff); }
      .gate h1 { font-size: 1.75rem; margin: 0; }
      .gate p { margin: 0; color: var(--muted, #666); }
      .gate input { font: inherit; padding: 0.75rem 1rem; border-radius: 0.75rem; border: 1px solid rgba(128,128,128,0.4); background: transparent; color: inherit; }
      .gate button { font: inherit; padding: 0.75rem 1rem; border: 0; border-radius: 999px; background: var(--accent, #2f7cf6); color: #fff; cursor: pointer; }
      .gate .gate-error { color: #c0392b; min-height: 1.25em; }
    </style>
  </head>
  <body>
    <div class="gate">
      <form id="gate-form" autocomplete="off">
        <h1>{lang === 'bg' ? 'Вход' : 'Sign in'}</h1>
        <p>{lang === 'bg' ? 'Това портфолио е защитено с парола.' : 'This portfolio is password protected.'}</p>
        <label class="sr-only" for="gate-pass">{lang === 'bg' ? 'Парола' : 'Password'}</label>
        <input id="gate-pass" type="password" placeholder={lang === 'bg' ? 'Парола' : 'Password'} required />
        <button type="submit">{lang === 'bg' ? 'Влез' : 'Enter'}</button>
        <p class="gate-error" id="gate-error" aria-live="polite"></p>
      </form>
    </div>
    <script is:inline define:vars={{ wrong: lang === 'bg' ? 'Грешна парола' : 'Wrong password' }}>
      (function () {
        var HASH = '5e884898da28047151d0e56f8dc6292773603d0d6aabbdd62a11ef721d1542d8';
        var form = document.getElementById('gate-form');
        if (!form) return;
        form.addEventListener('submit', async function (e) {
          e.preventDefault();
          var value = document.getElementById('gate-pass').value;
          var buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(value));
          var hex = Array.from(new Uint8Array(buf)).map(function (b) { return b.toString(16).padStart(2, '0'); }).join('');
          if (hex === HASH) {
            try { localStorage.setItem('site-unlocked', '1'); } catch (err) {}
            document.documentElement.classList.remove('locked');
          } else {
            document.getElementById('gate-error').textContent = wrong;
          }
        });
      })();
    </script>
    <a class="skip" href="#main">{ui.skip}</a>
    <header class="site-header">
      <div class="wrap header-row">
        <a class="wordmark" href={l(lang, '/work')}><img class="wordmark-face" src="/images/avatar.webp" alt="" width="64" height="64" />{site.name}</a>
        <nav class="nav no-js-row" id="site-nav" aria-label={ui.mainNav}>
          <ul>
            {nav.map((item) => (
              <li>
                <a href={l(lang, item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
              </li>
            ))}
          </ul>
          <div class="prefs-row">
            <div class="prefs">
              <button class="prefs-btn" type="button" aria-expanded="false" aria-controls="language-panel" aria-label={ui.language}>
                <Icon name="globe" />
                <span>{lang.toUpperCase()}</span>
                <svg class="prefs-chevron" viewBox="0 0 10 6" aria-hidden="true" focusable="false"><path d="M1 1l4 4 4-4" /></svg>
              </button>
              <div class="prefs-panel" id="language-panel">
                <p class="prefs-title"><Icon name="globe" />{ui.language}</p>
                <a class="prefs-option" href={l('en', path)} hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : undefined}>English</a>
                <a class="prefs-option" href={l('bg', path)} hreflang="bg" lang="bg" aria-current={lang === 'bg' ? 'true' : undefined}>Български</a>
              </div>
            </div>
            <div class="prefs prefs-theme">
              <button class="prefs-btn prefs-icon-btn" type="button" aria-expanded="false" aria-controls="theme-panel" aria-label={ui.theme}>
                <span class="when-light"><Icon name="sun" /></span>
                <span class="when-dark"><Icon name="moon" /></span>
              </button>
              <div class="prefs-panel" id="theme-panel">
                <p class="prefs-title"><span class="when-light"><Icon name="sun" /></span><span class="when-dark"><Icon name="moon" /></span>{ui.theme}</p>
                <button class="prefs-option" type="button" data-set-theme="light" aria-pressed="false"><span class="prefs-label"><Icon name="sun" />{ui.light}</span></button>
                <button class="prefs-option" type="button" data-set-theme="dark" aria-pressed="false"><span class="prefs-label"><Icon name="moon" />{ui.dark}</span></button>
              </div>
            </div>
          </div>
        </nav>
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" data-menu={ui.menu} data-close={ui.close}>{ui.menu}</button>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer wrap">
      <p class="footer-invite">
        <a class="invite-link" href={`mailto:${site.contact.email}`} data-email={site.contact.email}>{inviteAsk && <>{inviteAsk} </>}<span class="footer-cta">{inviteCta}</span></a>
        <button class="invite-copy" type="button" hidden data-copied={ui.copied}>{ui.copyEmail}</button>
      </p>
      <p class="sr-only" aria-live="polite" id="invite-status"></p>
      <ul class="footer-links">
        {site.contact.linkedin && (
          <li><a href={site.contact.linkedin} target="_blank" rel="noopener"><Icon name="link" />LinkedIn</a></li>
        )}
        {site.contact.location && <li class="footer-place"><Icon name="pin" />{site.contact.location}</li>}
      </ul>
      <div class="meta footer-bottom">
        <span>© {new Date().getFullYear()} {site.name}</span>
        <a href={l(lang, '/work/this-website')}>{ui.footerCredit}</a>
      </div>
    </footer>

    <script>
      const button = document.querySelector<HTMLButtonElement>('.menu-btn');
      const nav = document.getElementById('site-nav');
      const blocked = [document.querySelector('main'), document.querySelector('footer')];

      function setOpen(open: boolean) {
        if (!button || !nav) return;
        nav.classList.toggle('open', open);
        button.setAttribute('aria-expanded', String(open));
        button.textContent = (open ? button.dataset.close : button.dataset.menu) ?? '';
        document.body.classList.toggle('menu-open', open);
        blocked.forEach((el) => el?.toggleAttribute('inert', open));
      }

      button?.addEventListener('click', () => {
        setOpen(button.getAttribute('aria-expanded') !== 'true');
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && button?.getAttribute('aria-expanded') === 'true') {
          setOpen(false);
          button.focus();
        }
      });
      window.matchMedia('(min-width: 1100px)').addEventListener('change', () => setOpen(false));

      const dropdowns = Array.from(document.querySelectorAll<HTMLElement>('.prefs'));

      function setDropdownOpen(dropdown: HTMLElement, open: boolean) {
        dropdown.classList.toggle('open', open);
        dropdown.querySelector('.prefs-btn')?.setAttribute('aria-expanded', String(open));
      }

      dropdowns.forEach((dropdown) => {
        dropdown.querySelector('.prefs-btn')?.addEventListener('click', () => {
          const open = !dropdown.classList.contains('open');
          dropdowns.forEach((other) => setDropdownOpen(other, other === dropdown && open));
        });
      });
      document.addEventListener('click', (event) => {
        dropdowns.forEach((dropdown) => {
          if (!dropdown.contains(event.target as Node)) setDropdownOpen(dropdown, false);
        });
      });
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        dropdowns.forEach((dropdown) => {
          if (!dropdown.classList.contains('open')) return;
          setDropdownOpen(dropdown, false);
          dropdown.querySelector<HTMLElement>('.prefs-btn')?.focus();
        });
      });

      const root = document.documentElement;
      const themeOptions = document.querySelectorAll<HTMLButtonElement>('[data-set-theme]');

      function showTheme() {
        themeOptions.forEach((option) => {
          option.setAttribute('aria-pressed', String(option.dataset.setTheme === root.dataset.theme));
        });
      }
      themeOptions.forEach((option) => {
        option.addEventListener('click', () => {
          root.dataset.theme = option.dataset.setTheme;
          try { localStorage.setItem('theme', option.dataset.setTheme ?? ''); } catch {}
          showTheme();
        });
      });
      showTheme();

      // The first click on "Let's connect." reveals the email and a copy button; the next one opens the mail app.
      const invite = document.querySelector<HTMLAnchorElement>('.invite-link');
      const cta = invite?.querySelector<HTMLElement>('.footer-cta');
      const copy = document.querySelector<HTMLButtonElement>('.invite-copy');
      const status = document.getElementById('invite-status');
      const calm = window.matchMedia('(prefers-reduced-motion: reduce)');
      let sent = false;

      function showEmail() {
        if (!invite || !cta) return;
        cta.textContent = invite.dataset.email ?? '';
        cta.classList.add('is-email');
        if (copy) copy.hidden = false;
        if (status) status.textContent = invite.dataset.email ?? '';
        if (!calm.matches) {
          cta.animate([{ opacity: 0, transform: 'translateY(0.4em)' }, { opacity: 1, transform: 'none' }], { duration: 450, easing: 'cubic-bezier(.2,.7,.2,1)' });
        }
      }

      invite?.addEventListener('click', (event) => {
        if (sent || !cta || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        sent = true;
        showEmail();
      });

      copy?.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(invite?.dataset.email ?? '');
          const label = copy.textContent;
          copy.textContent = `${copy.dataset.copied} ✓`;
          if (status) status.textContent = copy.dataset.copied ?? '';
          setTimeout(() => { copy.textContent = label; }, 2000);
        } catch {}
      });
    </script>
  </body>
</html>
